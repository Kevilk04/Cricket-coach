# Copy this file to .env and fill in ONE of the options below.
# Never put these values in the mobile app.

PORT=8787

# Option 1: Groq. Free tier, very fast. Get a key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-key-here
LLM_MODEL=openai/gpt-oss-20b
# Optional: extra settings sent with every request, as JSON. Check your provider's docs first.
# LLM_EXTRA_JSON={"reasoning_effort":"low"}

# Option 2: Google Gemini. Free tier. Get a key at https://aistudio.google.com
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=paste-your-key-here
# LLM_MODEL=pick-a-flash-model-from-ai-studio

# Option 3: Ollama on this laptop. No key, no cost, works offline. Slower without a good GPU.
# Install Ollama, run:  ollama pull llama3.2:3b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.2:3b

# The grip photo check needs a model that can look at pictures.
# Groq:   LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct   (the default)
# Gemini: use the same flash model as LLM_MODEL (it can see pictures)
# Ollama: run  ollama pull llava  and set LLM_VISION_MODEL=llava
# Leave it empty (LLM_VISION_MODEL=) to switch the grip photo check off.
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Upper limit on the length of an answer.
LLM_MAX_TOKENS=400
